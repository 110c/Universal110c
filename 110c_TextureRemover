        gitLabel.Text = "Discord @100qa"

        if not autoActive then
            autoToggleBtn.BackgroundColor3 = Color3.fromRGB(128, 0, 128)
        end
    else

        smallBtn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
        smallBtn.Text = "110c"
        titleBar.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
        gitLabel.Text = "Github.com/110c"
        if not autoActive then
            autoToggleBtn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
        end
    end
end

applyCycle()

task.spawn(function()
    while true do
        task.wait(15)
        cycleState = not cycleState
        applyCycle()
    end
end)

local function clampFrame(frame)
    local function doClamp()
        local absPos = frame.AbsolutePosition
        local absSize = frame.AbsoluteSize
        local screenSize = Camera.ViewportSize
        local newX = math.clamp(absPos.X, 0, math.max(0, screenSize.X - absSize.X))
        local newY = math.clamp(absPos.Y, 0, math.max(0, screenSize.Y - absSize.Y))
        if newX ~= absPos.X or newY ~= absPos.Y then
            frame.Position = UDim2.new(0, newX, 0, newY)
        end
    end
    frame:GetPropertyChangedSignal("Position"):Connect(doClamp)
    Camera:GetPropertyChangedSignal("ViewportSize"):Connect(doClamp)
    doClamp()
end

