local function stripEverything()
    local myChar = player.Character

    for _, obj in ipairs(workspace:GetDescendants()) do
        if myChar and obj:IsDescendantOf(myChar) then
            continue
        end
        if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
            for _, v in ipairs(obj:GetChildren()) do
                if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") then
                    v:Destroy()
                end
            end
            obj.Material = Enum.Material.Plastic
            obj.Color = Color3.fromRGB(100, 100, 100)
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        if plr.Character then
            local char = plr.Character
            for _, v in ipairs(char:GetChildren()) do
                if v:IsA("Accessory") or v:IsA("Hat") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("Clothing") then
                    v:Destroy()
                end
            end
            local head = char:FindFirstChild("Head")
            if head then
                for _, v in ipairs(head:GetChildren()) do
                    if v:IsA("Decal") and string.lower(v.Name) ~= "face" then
                        v:Destroy()
                    end
                end
            end
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") and part.Name ~= "Head" then
                    part.Material = Enum.Material.Plastic
                    part.Color = Color3.fromRGB(163, 162, 165)
                end
            end
        end
    end
end

local autoActive = false
local autoThread = nil

local function stopAuto()
    autoActive = false
    if autoThread then
        task.cancel(autoThread)
        autoThread = nil
    end

    autoToggleBtn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
    autoToggleBtn.Text = ""
end

local function startAuto()
    if autoActive then return end
    autoActive = true

    autoToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)

    autoThread = task.spawn(function()
        while autoActive do
            for i = 30, 1, -1 do
                if not autoActive then return end
                autoToggleBtn.Text = tostring(i)
                task.wait(1)
            end
            if autoActive then
                stripEverything()
            end
        end
    end)
end

autoToggleBtn.MouseButton1Click:Connect(function()
    if autoActive then
        stopAuto()
    else
        startAuto()
    end
end)

local lastManual = 0
manualBtn.MouseButton1Click:Connect(function()
    if tick() - lastManual < 1 then return end
    lastManual = tick()
    stripEverything()
end)

