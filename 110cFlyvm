local flying = false
local connection = nil
local bv = nil
local keys = {W=false, A=false, S=false, D=false, Space=false, Ctrl=false}
local char, humanoid, root
local wasAnchored = false

local function updateChar(newChar)
    char = newChar
    humanoid = newChar:WaitForChild("Humanoid", 5)
    root = newChar:WaitForChild("HumanoidRootPart", 5)
end

if player.Character then updateChar(player.Character) end
player.CharacterAdded:Connect(updateChar)

local function startFlying()
    if not root or not humanoid then return end
    flying = true

    wasAnchored = root.Anchored
    root.Anchored = true

    humanoid.PlatformStand = true

    bv = Instance.new("BodyVelocity")
    bv.Name = "FlyVelocity"
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.new(0,0,0)
    bv.Parent = root

    connection = RunService.Heartbeat:Connect(function()
        if not flying then return end

        local move = Vector3.new(0, 0, 0)
        if keys.W then move = move + camera.CFrame.LookVector end
        if keys.S then move = move - camera.CFrame.LookVector end
        if keys.A then move = move - camera.CFrame.RightVector end
        if keys.D then move = move + camera.CFrame.RightVector end
        if keys.Space then move = move + Vector3.new(0,1,0) end
        if keys.Ctrl then move = move - Vector3.new(0,1,0) end

        if move.Magnitude > 0 then
            bv.Velocity = move.Unit * speed
            root.Anchored = false   -- Allow movement when pressing keys
        else
            bv.Velocity = Vector3.new(0,0,0)
            root.Anchored = true    -- Anchor when not moving
        end

        if root then
            root.CFrame = CFrame.new(root.Position, root.Position + camera.CFrame.LookVector)
        end
    end)
end

local function stopFlying()
    flying = false
    if connection then connection:Disconnect() connection = nil end
    if bv then bv:Destroy() bv = nil end
    if root then root.Anchored = wasAnchored end
    if humanoid then humanoid.PlatformStand = false end
end

flyButton.MouseButton1Click:Connect(function()
    flying = not flying
    if flying then
        flyButton.Text = "FLY: ON"
        flyButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        startFlying()
    else
        flyButton.Text = "FLY: OFF"
        flyButton.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
        stopFlying()
    end
end)

local holdingPlus = false
local holdingMinus = false

plusBtn.MouseButton1Down:Connect(function()
    holdingPlus = true
    while holdingPlus do
        if speed < 200 then
            speed = math.clamp(speed + 5, 20, 200)
        else
            speed = math.clamp(speed + 30, 20, 5000)
        end
        speedLabel.Text = "Speed: " .. speed
        task.wait(speed < 200 and 0.12 or 0.04)
    end
end)

plusBtn.MouseButton1Up:Connect(function() holdingPlus = false end)

minusBtn.MouseButton1Down:Connect(function()
    holdingMinus = true
    while holdingMinus do
        if speed < 200 then
            speed = math.clamp(speed - 5, 20, 200)
        else
            speed = math.clamp(speed - 30, 20, 5000)
        end
        speedLabel.Text = "Speed: " .. speed
        task.wait(speed < 200 and 0.12 or 0.04)
    end
end)

minusBtn.MouseButton1Up:Connect(function() holdingMinus = false end)

closeBtn.MouseButton1Click:Connect(function()
